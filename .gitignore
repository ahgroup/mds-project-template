# R session and history files
.Rhistory
.Rapp.history
.RData

# Example code in R package build process
*-Ex.R

# Output files from R package build/check
/*.tar.gz
/*.Rcheck/

# RStudio local project files
.Rproj.user/

# OAuth2 tokens, secrets, and local environment files
.httr-oauth
.Renviron
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# knitr, R Markdown, and Quarto intermediate/cache files
# These are created next to the source document, not at the project root, so
# the patterns are deliberately not anchored with a leading slash.
*_cache/
*_files/
/cache/
.quarto/
*.utf8.md
*.knit.md

Rplots.pdf

# Operating-system and editor clutter
.DS_Store
Thumbs.db
.vscode/
.idea/

# Python local environments/cache files, if a project adds Python later
.venv/
venv/
__pycache__/
.ipynb_checkpoints/

# renv local package libraries/state, if a project enables renv later.
# Note that renv.lock itself belongs in the repository and is not ignored here.
renv/library/
renv/staging/
renv/local/
renv/cellar/
renv/python/
renv/sandbox/

# Rendered versions of the Quarto files in code/
# The code/ folder holds source, not deliverables. Rendering the example Quarto
# files there is useful for checking them, but the rendered documents belong in
# products/. Remove these lines if a project wants to track them.
code/**/*.html
code/**/*.docx
code/**/*.pdf

# Local/private data files
# Commit readmes/placeholders, but keep private or large data local.
data/private-data/*
!data/private-data/readme-private-data.md
data/large-files/*
!data/large-files/readme-large-files.md

# Large generated result files
# Generated outputs are generally committed, but large outputs belong here.
results/large-files/*
!results/large-files/readme-large-files.md

# Local AI/tool state and scratch files
.ai-local/
.ai-cache/
.codex/
.claude/settings.local.json
.aider*
